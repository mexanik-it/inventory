constexpr WORD COLOR_GRAY   = FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE;                 // приглушённый белый
constexpr WORD COLOR_GREEN  = FOREGROUND_GREEN | FOREGROUND_INTENSITY;                             // ярко-зелёный
constexpr WORD COLOR_RED    = FOREGROUND_RED | FOREGROUND_INTENSITY;                               // ярко-красный
constexpr WORD COLOR_DEFAULT = FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE | FOREGROUND_INTENSITY;

// Вспомогательная функция: установить цвет
static inline void setConsoleColor(WORD color) {
    HANDLE hStdout = GetStdHandle(STD_OUTPUT_HANDLE);
    SetConsoleTextAttribute(hStdout, color);
}

static inline bool isConsoleOutput() {
    return _isatty(_fileno(stdout));
}

void okMessage(const std::string& msg) {
    // Если вывод не в консоль (перенаправление в файл), печатаем сразу без эффектов
    if (!isConsoleOutput()) {
        std::cout << "[ Ok ] " << msg << "\n";
        return;
    }

    // 1. Сразу печатаем "[ Ok ]" — не надо тянуть это анимацией
    setConsoleColor(COLOR_GRAY);
    std::cout << "[  ";

    setConsoleColor(COLOR_GREEN);
    std::cout << "Ok";

    setConsoleColor(COLOR_GRAY);
    std::cout << "  ]  ";

    // 2. Печатаем сообщение посимвольно с задержкой
    for (char c : msg) {
        std::cout << c;
        std::cout.flush(); // обязательно: чтобы символ появился сразу
        std::this_thread::sleep_for(std::chrono::milliseconds(25)); // 0.5 сек
    }

    // 3. Возвращаем цвет по умолчанию и перевод строки
    setConsoleColor(COLOR_DEFAULT);
    std::cout << "\n";
}

// [Fail] красный, сообщение серое
void errMessage(const std::string& msg) {
    setConsoleColor(COLOR_GRAY);
    std::cout << "[ ";

    setConsoleColor(COLOR_RED);
    std::cout << "Fail";

    setConsoleColor(COLOR_GRAY);
    std::cout << " ]  ";
    // 2. Печатаем сообщение посимвольно с задержкой
    for (char c : msg) {
        std::cout << c;
        std::cout.flush(); // обязательно: чтобы символ появился сразу
        std::this_thread::sleep_for(std::chrono::milliseconds(25)); // 0.5 сек
    }


    setConsoleColor(COLOR_DEFAULT);
    std::cout << "\n";
}

bool rebuildFont( ) {
    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
    if (hOut == INVALID_HANDLE_VALUE) return 1;

    CONSOLE_FONT_INFOEX cfi;
    ZeroMemory(&cfi, sizeof(cfi));
    cfi.cbSize = sizeof(cfi);

    // Получаем текущие настройки шрифта
    if (!GetCurrentConsoleFontEx(hOut, FALSE, &cfi)) {
        std::cerr << "GetCurrentConsoleFontEx failed\n";
        return 1;
    }

    // Меняем размер: X и Y в логических единицах (ширина и высота символа)
    cfi.dwFontSize.X = 12;  // ширина
    cfi.dwFontSize.Y = 24; // высота

    // Можно также задать имя шрифта (строго по названию, без кавычек)
    wcscpy_s(cfi.FaceName, L"Cascadia Code");

    // Применяем новые настройки
    if (!SetCurrentConsoleFontEx(hOut, FALSE, &cfi)) {
        std::cerr << "SetCurrentConsoleFontEx failed\n";
    }

    return 0;
