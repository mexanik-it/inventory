    for (size_t i = 0; i < macs.size(); ++i) {
        const auto& m = macs[i];

        id_mac += (!m.mac.empty() ? m.mac : "NoMAC");
        id_ip  += (!m.ipv4.empty() ? m.ipv4 : "(none)");

        if (i + 1 < macs.size()) {
