#include <iostream>
#include "main.h"

/***************************************************************************************************/
/* возвращает производителя жесткого диска и название модели                                       */
/***************************************************************************************************/

/*-------------------------------------------------------------------------------------------------*/
/*                 модуль получения производителя жесткого диска и название модели                 */
/*-------------------------------------------------------------------------------------------------*/


bool TInventory::get_hdd() {

  FILE * pipe = _popen("wmic diskdrive get model", "r");
  if (!pipe) {
    cout << "Failed to execute wmic" << endl;
    return false;
  }

  char buffer[512];
  std::string result;

  while (fgets(buffer, sizeof(buffer), pipe) != nullptr) {
    result += buffer;
  }

  _pclose(pipe);

  // Убираем заголовок и лишние пробелы
  size_t firstLine = result.find("\n");
  if (firstLine != std::string::npos) {
    result = result.substr(firstLine + 1);
  }
  result.erase(0, result.find_first_not_of(" \t\n\r"));
  result.erase(result.find_last_not_of(" \t\n\r") + 1);

  // Находим позицию первого перевода строки
  size_t pos = result.find('\n');
  // Если перевод строки найден, удаляем всё начиная с него
  if (pos != std::string::npos) 
    result.erase(pos);

  pos = result.find(0x0D);
  // Если перевод строки найден, удаляем всё начиная с него
  if (pos != std::string::npos) 
    result.erase(pos);

  // cutting off the excess
    pos = result.find("  ");
    if (pos != std::string::npos) {
        result.erase(pos);
    }  

  id_hdd = result;
  return true;
}