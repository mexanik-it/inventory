@echo off
chcp 1251
cls
echo [33m================================================================================
echo [92m========       Transferring INVENTORY files to an FTP server            ========
echo.
choice /T 5 /D Y /M "Автопродолжение через 5 сек. Продолжить? "
if %errorlevel%==1 (
    echo Выполнение продолжено
) else (
    echo Выполнение прервано
)
echo  [96m Starting process .. [93m
curl -T linux/inventory ftp://a0831755:vbnz1002@ftp.denkin.ru/domains/denkin.ru/public_html/tmp/
::if curl -T README.md ftp://a0831755:vbnz1002@ftp.denkin.ru/domains/denkin.ru/public_html/tmp/
IF %ERRORLEVEL% EQU 0 (
    ECHO [92m [Linux] - File transfer completed successfully... [0m
) ELSE (
    ECHO [91m An error occurred while transferring the file... [0m
)

echo  [96m Starting process .. [93m
curl -T windows/inventory.exe ftp://a0831755:vbnz1002@ftp.denkin.ru/domains/denkin.ru/public_html/tmp/
::if curl -T README.md ftp://a0831755:vbnz1002@ftp.denkin.ru/domains/denkin.ru/public_html/tmp/
IF %ERRORLEVEL% EQU 0 (
    ECHO [92m [Windows] - File transfer completed successfully... [0m
) ELSE (
    ECHO [91m An error occurred while transferring the file... [0m
)

echo  [0m
pause